{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "public": true,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.php", "use": "@vercel/static" },
    { "src": "styles/**/*", "use": "@vercel/static" },
    { "src": "js/**/*", "use": "@vercel/static" },
    { "src": "api/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
} 